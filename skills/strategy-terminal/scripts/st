#!/usr/bin/env bash
# Strategy Terminal runner — the skill calls this directly; bin/st.sh is a shim.
#
#   st.sh AAPL                       one-shot command, anonymous
#   st.sh AAPL --show                render a report, open it, return page images
#   st.sh AAPL --show --no-open-pdf  report + page images, no browser window
#   st.sh NVDA --user-id 1           act as a stored local user
#   st.sh --list-commands            every command the engine knows
#   st.sh                            HELP
#
# Flags (tokens starting with --) are passed to app-cli.py; the remaining words
# form the terminal command. Everything may also arrive as one quoted string,
# so arguments are word-split before flags are classified.
#
# Configuration (all optional):
#   ST_CLI_APP_DIR   folder containing app-cli.py
#                    (default: the bundled app at
#                     ~/.config/opencode/strategy-terminal, then the checkout's
#                     app-cli/, then ~/Apps/StrategyTerminal)
#   ST_CLI_PYTHON    python with the app's deps
#                    (default <app>/venv/bin/python, <app>/.venv/bin/python,
#                     ~/venv/bin/python, python3)
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"

if [ -n "${ST_CLI_APP_DIR:-}" ]; then
  APP_DIR="$ST_CLI_APP_DIR"
elif [ -f "$CONFIG_DIR/strategy-terminal/app-cli.py" ]; then
  APP_DIR="$CONFIG_DIR/strategy-terminal"
elif [ -f "$HERE/../app-cli/app-cli.py" ]; then
  APP_DIR="$(cd "$HERE/../app-cli" && pwd)"   # running from the repository
elif [ -f "$HERE/../../app-cli/app-cli.py" ]; then
  APP_DIR="$(cd "$HERE/../../app-cli" && pwd)" # skills/<id>/scripts/
elif [ -f "$HERE/../../../app-cli/app-cli.py" ]; then
  APP_DIR="$(cd "$HERE/../../../app-cli" && pwd)" # <repo>/skills/<id>/scripts/
else
  APP_DIR="$HOME/Apps/StrategyTerminal"
fi

resolve_python() {
  if [ -n "${ST_CLI_PYTHON:-}" ]; then printf '%s' "$ST_CLI_PYTHON"; return; fi
  for candidate in \
    "$APP_DIR/venv/bin/python" \
    "$APP_DIR/.venv/bin/python" \
    "$HOME/venv/bin/python"; do
    [ -x "$candidate" ] && { printf '%s' "$candidate"; return; }
  done
  printf 'python3'
}

PYTHON="$(resolve_python)"

cd "$APP_DIR" 2>/dev/null || {
  echo "app-cli.py folder not found: $APP_DIR (set ST_CLI_APP_DIR)" >&2
  exit 1
}

# Split every incoming argument into words: `st.sh AAPL --show` and
# `st.sh "AAPL --show"` must behave identically.
words=()
for arg in "$@"; do
  read -r -a parts <<< "$arg"
  for word in "${parts[@]:-}"; do
    [ -n "$word" ] && words+=("$word")
  done
done

opts=()
identity=()
cmd_parts=()
show=false
open_pdf=true

i=0
while [ "$i" -lt "${#words[@]}" ]; do
  word="${words[$i]}"
  next="${words[$((i + 1))]:-}"
  case "$word" in
    --show)        show=true ;;
    --open-pdf)    show=true; open_pdf=true ;;
    --no-open-pdf) open_pdf=false ;;
    --user-id|--email)
      # identity flags always carry a value; keep the pair together
      if [ -n "$next" ]; then
        identity+=("$word" "$next")
        i=$((i + 1))
      fi
      ;;
    --max-rows)
      # value flag: keep the pair together so it never leaks into the command
      if [ -n "$next" ]; then
        opts+=("$word" "$next")
        i=$((i + 1))
      fi
      ;;
    --user-id=*|--email=*)
      identity+=("$word") ;;
    --*)           opts+=("$word") ;;
    *)             cmd_parts+=("$word") ;;
  esac
  i=$((i + 1))
done

cmd="${cmd_parts[*]:-HELP}"

# --show: build the report, open it in the browser and rasterise its pages so
# the chat can display them too. --no-open-pdf keeps the PDF on disk only.
if [ "$show" = true ]; then
  opts+=("--pdf")
  if [ "$open_pdf" = true ]; then
    opts+=("--open-pdf")
  else
    opts+=("--no-open-pdf")
  fi
  opts+=("--pdf-png")
fi

# Anonymous unless the caller supplied a --user-id / --email.
if [ "${#identity[@]}" -eq 0 ]; then
  identity=("--anonymous")
fi

exec "$PYTHON" app-cli.py "${identity[@]}" --no-save-data "${opts[@]}" "$cmd"
